NODE_ENV=development
APP_NAME=Bhumiraj Estates
APP_URL=http://localhost
API_INTERNAL_URL=http://api:3001
API_PUBLIC_URL=http://localhost
API_PORT=3001
WORKER_CONCURRENCY=8

DATABASE_URL=postgresql://bhumiraj:bhumiraj@postgres:5432/bhumiraj?schema=public
DIRECT_URL=postgresql://bhumiraj:bhumiraj@postgres:5432/bhumiraj?schema=public

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost/api/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

REDIS_CACHE_URL=redis://redis:6379/0
REDIS_CRITICAL_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_PUBLIC_BUCKET=bhumiraj-public
S3_PRIVATE_BUCKET=bhumiraj-private
S3_FORCE_PATH_STYLE=true
S3_AUTO_SETUP=true
S3_CONFIGURE_BUCKET_CORS=false
CDN_BASE_URL=http://localhost:9000/bhumiraj-public

MAIL_FROM=Bhumiraj Estates <auth@bhumiraj.local>
RESEND_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_SOCKET_PATH=/socket.io
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

E2E_MODE=false
E2E_SETUP_KEY=replace-with-at-least-16-random-characters
E2E_ADMIN_EMAIL=admin.e2e@bhumiraj.test
E2E_ADMIN_PASSWORD=AdminTest!234567

NEXT_PUBLIC_CDN_BASE_URL=http://localhost:9000/bhumiraj-public
PASSKEY_RP_ID=localhost
E2E_BIDDER_EMAIL=bidder.e2e@bhumiraj.test
E2E_BIDDER_PASSWORD=BidderTest!234567

ACCOUNT_DELETION_GRACE_DAYS=14

BHUMIRAJ_ADMIN_EMAIL=
BHUMIRAJ_ADMIN_PASSWORD=
BHUMIRAJ_ADMIN_NAME=Platform Owner
SEED_ADMIN_ON_START=false
SEED_ADMIN_RESET=false

VIEW_HASH_SECRET=replace-with-at-least-32-random-characters

# Malware scanning (required in production)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# Browser-visible object-storage origin used by signed uploads and CSP
NEXT_PUBLIC_UPLOAD_ORIGIN=http://localhost:9000
