generator client {
  provider = "prisma-client"
  output   = "../generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  USER
  AGENT
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserLifecycleStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

enum AgencyRole {
  OWNER
  MANAGER
  AGENT
  VIEWER
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL
  OFFICE
  WAREHOUSE
}

enum ListingType {
  SALE
  RENT
  AUCTION
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  WITHDRAWN
  ARCHIVED
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}

enum LocationPrecision {
  EXACT
  APPROXIMATE
  LOCALITY
}

enum MediaPurpose {
  LISTING_IMAGE
  PROFILE_IMAGE
  COVER_IMAGE
  OWNERSHIP_DOCUMENT
  KYC_DOCUMENT
  AGENT_LICENSE
  AGENCY_LOGO
  MESSAGE_ATTACHMENT
}

enum MediaStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  REJECTED
  DELETED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum InquiryStatus {
  OPEN
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

enum ViewingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ConversationType {
  LISTING
  DIRECT
  SUPPORT
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  LIVE
  PAUSED
  ENDED
  AWAITING_SETTLEMENT
  SETTLED
  CANCELLED
  VOIDED
}

enum RegistrationStatus {
  PENDING
  ELIGIBLE
  REJECTED
  WITHDRAWN
}

enum DepositStatus {
  NOT_REQUIRED
  PENDING
  AUTHORIZED
  CAPTURED
  RELEASED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ModerationStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  PROFILE_UPDATED
  USER_ROLE_CHANGED
  USER_BANNED
  USER_UNBANNED
  USER_DELETION_REQUESTED
  USER_DELETED
  LISTING_CREATED
  LISTING_SUBMITTED
  LISTING_PUBLISHED
  LISTING_REJECTED
  LISTING_WITHDRAWN
  AUCTION_CREATED
  AUCTION_STARTED
  AUCTION_PAUSED
  AUCTION_RESUMED
  AUCTION_ENDED
  AUCTION_CANCELLED
  BID_ACCEPTED
  ADMIN_IMPERSONATION_STARTED
  ADMIN_IMPERSONATION_ENDED
  MEDIA_REJECTED
  REPORT_REVIEWED
  SETTINGS_UPDATED
}

// Better Auth core and plugin models
model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  role             String   @default("USER")
  banned           Boolean  @default(false)
  banReason        String?
  banExpires       DateTime? @db.Timestamptz(3)
  twoFactorEnabled Boolean  @default(false)
  lifecycleStatus  UserLifecycleStatus @default(ACTIVE)
  deletionRequestedAt DateTime? @db.Timestamptz(3)
  anonymizedAt     DateTime? @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]
  passkeys Passkey[]
  twoFactor TwoFactor?
  profile UserProfile?
  identityVerification IdentityVerification?
  identityVerificationsReviewed IdentityVerification[] @relation("IdentityVerificationReviewer")
  agencyMemberships AgencyMember[]
  agentProfile AgentProfile?
  properties Property[] @relation("PropertyOwner")
  listings Listing[] @relation("ListingCreator")
  favorites Favorite[]
  savedSearches SavedSearch[]
  follows AgentFollow[] @relation("Follower")
  followedBy AgentFollow[] @relation("FollowedAgent")
  inquiries ListingInquiry[]
  assignedInquiries ListingInquiry[] @relation("AssignedInquiryAgent")
  viewingRequests ViewingRequest[]
  conversationParticipants ConversationParticipant[]
  messages Message[]
  auctionRegistrations AuctionRegistration[]
  bids Bid[]
  notifications Notification[]
  reports UserReport[] @relation("Reporter")
  reportsAgainst UserReport[] @relation("ReportedUser")
  auditLogs AuditLog[] @relation("AuditActor")
  mediaAssets MediaAsset[]
  idempotencyKeys IdempotencyKey[]
  pushSubscriptions PushSubscription[]
  paymentIntents PaymentIntent[]
  authoredAgentReviews AgentReview[] @relation("AgentReviewAuthor")
  listingReports ListingReport[] @relation("ListingReporter")
  priceChanges ListingPriceHistory[] @relation("ListingPriceChanger")
  listingStatusChanges ListingStatusHistory[] @relation("ListingStatusActor")
  auctionSettlementsAsBuyer AuctionSettlement[] @relation("SettlementBuyer")
  auctionSettlementsAsSeller AuctionSettlement[] @relation("SettlementSeller")
  auctionStatusChanges AuctionStatusHistory[] @relation("AuctionStatusActor")
  settingsUpdated SystemSetting[] @relation("SystemSettingUpdater")

  @@index([role, createdAt])
  @@index([banned, createdAt])
  @@index([lifecycleStatus, createdAt])
}

model Session {
  id             String   @id @default(uuid())
  expiresAt      DateTime @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  authMethod    String?
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([userId, authMethod, expiresAt])
  @@index([expiresAt])
}

model Account {
  id                    String   @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  @@index([identifier])
  @@index([expiresAt])
}

model Passkey {
  id           String   @id @default(uuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String   @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  aaguid       String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model TwoFactor {
  id                      String @id @default(uuid())
  secret                  String
  backupCodes             String
  verified                Boolean @default(false)
  failedVerificationCount Int @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)
  userId                  String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id            String @id @default(uuid())
  userId        String @unique
  username      String? @unique
  bio           String? @db.VarChar(500)
  phone         String? @unique
  phoneVerifiedAt DateTime? @db.Timestamptz(3)
  coverImageUrl String?
  locale        String @default("en")
  timezone      String @default("Asia/Kathmandu")
  lastSeenAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([lastSeenAt])
}

model IdentityVerification {
  id String @id @default(uuid())
  userId String @unique
  status VerificationStatus @default(NOT_STARTED)
  provider String?
  providerReference String?
  reviewedById String?
  reason String?
  submittedAt DateTime? @db.Timestamptz(3)
  verifiedAt DateTime? @db.Timestamptz(3)
  expiresAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("IdentityVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@index([status, submittedAt])
  @@index([reviewedById, status])
}

model Agency {
  id String @id @default(uuid())
  name String
  slug String @unique
  description String?
  logoUrl String?
  phone String?
  email String?
  verifiedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  members AgencyMember[]
  listings Listing[]
  @@index([verifiedAt, createdAt])
}

model AgencyMember {
  id String @id @default(uuid())
  agencyId String
  userId String
  role AgencyRole @default(AGENT)
  joinedAt DateTime @default(now()) @db.Timestamptz(3)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([agencyId, userId])
  @@index([userId, role])
}

model AgentProfile {
  id String @id @default(uuid())
  userId String @unique
  licenseNumber String? @unique
  headline String?
  about String?
  verifiedAt DateTime? @db.Timestamptz(3)
  averageRating Decimal @default(0) @db.Decimal(3,2)
  reviewCount Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews AgentReview[]
  @@index([verifiedAt, averageRating])
}

model AgentReview {
  id String @id @default(uuid())
  agentProfileId String
  authorId String
  rating Int
  comment String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  agentProfile AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  author User @relation("AgentReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  @@unique([agentProfileId, authorId])
  @@index([agentProfileId, createdAt])
  @@index([authorId, createdAt])
}

model AdministrativeArea {
  id String @id @default(uuid())
  parentId String?
  level Int
  name String
  slug String
  code String?
  parent AdministrativeArea? @relation("AreaTree", fields: [parentId], references: [id], onDelete: Restrict)
  children AdministrativeArea[] @relation("AreaTree")
  addresses Address[]
  @@unique([parentId, slug])
  @@index([level, name])
}

model Address {
  id String @id @default(uuid())
  areaId String?
  province String
  district String
  municipality String
  ward String?
  locality String
  street String?
  postalCode String?
  latitude Decimal? @db.Decimal(9,6)
  longitude Decimal? @db.Decimal(9,6)
  publicLatitude Decimal? @db.Decimal(9,6)
  publicLongitude Decimal? @db.Decimal(9,6)
  precision LocationPrecision @default(APPROXIMATE)
  location Unsupported("geography(Point,4326)")?
  area AdministrativeArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  properties Property[]
  @@index([district, municipality, locality])
  @@index([location], type: Gist)
  @@index([areaId])
}

model Property {
  id String @id @default(uuid())
  ownerId String
  addressId String
  type PropertyType
  titleReference String?
  ownershipStatus VerificationStatus @default(NOT_STARTED)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  owner User @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  address Address @relation(fields: [addressId], references: [id], onDelete: Restrict)
  specification PropertySpecification?
  documents PropertyDocument[]
  listings Listing[]
  amenities PropertyAmenity[]
  @@index([ownerId, createdAt])
  @@index([type, ownershipStatus])
  @@index([addressId])
}

model PropertySpecification {
  id String @id @default(uuid())
  propertyId String @unique
  bedrooms Int?
  bathrooms Int?
  kitchens Int?
  floors Int?
  parkingSpaces Int?
  areaSqFt Decimal @db.Decimal(14,2)
  landAreaAana Decimal? @db.Decimal(12,4)
  builtYear Int?
  furnishing Furnishing?
  facing String?
  roadAccessFeet Decimal? @db.Decimal(8,2)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Amenity {
  id String @id @default(uuid())
  name String @unique
  slug String @unique
  category String
  properties PropertyAmenity[]
}
model PropertyAmenity {
  propertyId String
  amenityId String
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Restrict)
  @@id([propertyId, amenityId])
  @@index([amenityId, propertyId])
}

model PropertyDocument {
  id String @id @default(uuid())
  propertyId String
  mediaAssetId String @unique
  type String
  verifiedAt DateTime? @db.Timestamptz(3)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  @@index([propertyId, type])
}

model Listing {
  id String @id @default(uuid())
  propertyId String
  createdById String
  agencyId String?
  slug String @unique
  title String @db.VarChar(160)
  description String @db.Text
  type ListingType
  status ListingStatus @default(DRAFT)
  currency String @default("NPR") @db.Char(3)
  priceMinor BigInt?
  rentPeriod String?
  isVerified Boolean @default(false)
  featuredUntil DateTime? @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  withdrawnAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  version Int @default(1)
  favoriteCount Int @default(0)
  inquiryCount Int @default(0)
  viewCount BigInt @default(0)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  createdBy User @relation("ListingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  media ListingMedia[]
  priceHistory ListingPriceHistory[]
  statusHistory ListingStatusHistory[]
  favorites Favorite[]
  inquiries ListingInquiry[]
  viewingRequests ViewingRequest[]
  conversations Conversation[]
  auction Auction?
  views ListingView[]
  reports ListingReport[]
  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([status, type, priceMinor, id])
  @@index([status, featuredUntil, publishedAt])
  @@index([status, favoriteCount(sort: Desc), viewCount(sort: Desc), publishedAt(sort: Desc), id(sort: Desc)])
  @@index([propertyId, createdAt])
  @@index([createdById, status, createdAt])
  @@index([createdById, status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([agencyId, status, createdAt])
}

model ListingMedia {
  id String @id @default(uuid())
  listingId String
  mediaAssetId String
  position Int
  altText String?
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  @@unique([listingId, position])
  @@unique([listingId, mediaAssetId])
  @@unique([mediaAssetId])
}
model ListingPriceHistory {
  id String @id @default(uuid())
  listingId String
  currency String @db.Char(3)
  priceMinor BigInt
  changedById String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  changedBy User @relation("ListingPriceChanger", fields: [changedById], references: [id], onDelete: Restrict)
  @@index([listingId, createdAt(sort: Desc)])
  @@index([changedById, createdAt(sort: Desc)])
}
model ListingStatusHistory {
  id String @id @default(uuid())
  listingId String
  fromStatus ListingStatus?
  toStatus ListingStatus
  reason String?
  actorId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actor User @relation("ListingStatusActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([listingId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

model MediaAsset {
  id String @id @default(uuid())
  ownerId String
  purpose MediaPurpose
  visibility Visibility
  status MediaStatus @default(UPLOADING)
  bucket String
  objectKey String @unique
  originalFileName String
  contentType String
  sizeBytes BigInt
  checksum String?
  width Int?
  height Int?
  rejectionReason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  readyAt DateTime? @db.Timestamptz(3)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  variants MediaVariant[]
  listingMedia ListingMedia[]
  propertyDocument PropertyDocument?
  messageAttachments MessageAttachment[]
  @@index([ownerId, status, createdAt])
  @@index([status, createdAt])
}
model MediaVariant {
  id String @id @default(uuid())
  mediaAssetId String
  name String
  objectKey String @unique
  contentType String
  sizeBytes BigInt
  width Int?
  height Int?
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  @@unique([mediaAssetId, name])
}

model Favorite {
  userId String
  listingId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@id([userId, listingId])
  @@index([listingId, createdAt])
}
model SavedSearch {
  id String @id @default(uuid())
  userId String
  name String
  filters Json
  alertsEnabled Boolean @default(false)
  lastNotifiedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, name])
  @@index([userId, createdAt])
  @@index([alertsEnabled, lastNotifiedAt])
}
model ListingView {
  id BigInt @id @default(autoincrement())
  listingId String
  userId String?
  visitorHash String?
  viewerKey String
  viewDate DateTime @db.Date
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@unique([listingId, viewerKey, viewDate])
  @@index([listingId, occurredAt])
  @@index([userId, occurredAt])
}
model AgentFollow {
  followerId String
  agentUserId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  agent User @relation("FollowedAgent", fields: [agentUserId], references: [id], onDelete: Cascade)
  @@id([followerId, agentUserId])
  @@index([agentUserId, createdAt])
}

model ListingInquiry {
  id String @id @default(uuid())
  listingId String
  userId String
  assignedAgentId String?
  message String @db.VarChar(2000)
  status InquiryStatus @default(OPEN)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedAgent User? @relation("AssignedInquiryAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  @@index([listingId, status, createdAt])
  @@index([assignedAgentId, status, createdAt])
  @@index([userId, createdAt])
}
model ViewingRequest {
  id String @id @default(uuid())
  listingId String
  requesterId String
  scheduledAt DateTime @db.Timestamptz(3)
  status ViewingStatus @default(REQUESTED)
  notes String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  requester User @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  @@index([listingId, scheduledAt])
  @@index([requesterId, status, scheduledAt])
}

model Conversation {
  id String @id @default(uuid())
  conversationKey String @unique
  type ConversationType
  listingId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages Message[]
  @@index([listingId, updatedAt])
  @@index([updatedAt(sort: Desc), id(sort: Desc)])
}
model ConversationParticipant {
  conversationId String
  userId String
  joinedAt DateTime @default(now()) @db.Timestamptz(3)
  lastReadAt DateTime? @db.Timestamptz(3)
  unreadCount Int @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
  @@index([userId, archivedAt, conversationId])
  @@index([userId, unreadCount])
}
model Message {
  id String @id @default(uuid())
  conversationId String
  senderId String
  body String @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  editedAt DateTime? @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Restrict)
  attachments MessageAttachment[]
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
}
model MessageAttachment {
  id String @id @default(uuid())
  messageId String
  mediaAssetId String
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  @@unique([messageId, mediaAssetId])
  @@unique([mediaAssetId])
  @@index([messageId])
}

model Auction {
  id String @id @default(uuid())
  listingId String @unique
  status AuctionStatus @default(DRAFT)
  currency String @db.Char(3)
  startingAmountMinor BigInt
  reserveAmountMinor BigInt?
  currentAmountMinor BigInt
  currentBidId String? @unique
  minimumIncrementMinor BigInt
  startsAt DateTime @db.Timestamptz(3)
  originalEndsAt DateTime @db.Timestamptz(3)
