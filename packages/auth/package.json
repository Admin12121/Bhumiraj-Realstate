{
  "name": "@real-estate/auth",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./method": {
      "types": "./dist/auth-method.d.ts",
      "default": "./dist/auth-method.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo no-tests"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@real-estate/database": "workspace:*",
    "better-auth": "catalog:",
    "@real-estate/config": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "typesVersions": {
    "*": {
      "method": [
        "./dist/auth-method.d.ts"
      ],
      "client": [
        "./dist/client.d.ts"
      ]
    }
  }
}
