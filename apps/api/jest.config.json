{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "roots": [
    "<rootDir>/src"
  ],
  "testEnvironment": "node",
  "testRegex": ".spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@real-estate/auth/method$": "<rootDir>/../../packages/auth/src/auth-method",
    "^@real-estate/auth/client$": "<rootDir>/../../packages/auth/src/client",
    "^@real-estate/auth$": "<rootDir>/../../packages/auth/src/server",
    "^@real-estate/(.*)$": "<rootDir>/../../packages/$1/src"
  },
  "maxWorkers": 1
}
