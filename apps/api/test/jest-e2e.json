{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }] },
  "moduleNameMapper": {
    "^@real-estate/(.*)$": "<rootDir>/../../packages/$1/src"
  },
  "maxWorkers": 1
}
