{
  "name": "real-estate-platform",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:packages && turbo run dev --parallel",
    "dev:web": "bun run build:packages && bun --cwd apps/web dev",
    "dev:api": "bun run build:packages && bun --cwd apps/api start:dev",
    "dev:worker": "bun run build:packages && bun --cwd apps/worker start:dev",
    "build": "turbo run build",
    "build:web": "bun --cwd apps/web build",
    "build:api": "bun --cwd apps/api build",
    "build:worker": "bun --cwd apps/worker build",
    "lint": "turbo run lint",
    "typecheck": "bun run build:packages && turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "bun --cwd apps/web test:e2e",
    "test:api:e2e": "bun --cwd apps/api test:e2e",
    "db:generate": "bun --cwd packages/database db:generate",
    "db:migrate": "bun --cwd packages/database db:migrate",
    "db:deploy": "bun --cwd packages/database db:deploy",
    "db:seed": "bun --cwd packages/database db:seed",
    "db:studio": "bun --cwd packages/database db:studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "dev:reload": "docker compose restart web && node scripts/wait-for-web.mjs",
    "dev:reload:api": "docker compose restart api worker",
    "check": "bun run lint && bun run typecheck && bun run test",
    "build:packages": "turbo run build \"--filter=./packages/*\"",
    "build:packages:watch": "node scripts/watch-packages.mjs",
    "audit:static": "node scripts/static-audit.mjs && node scripts/dependency-boundary-audit.mjs && node scripts/prisma-schema-audit.mjs",
    "audit:deps": "bun audit --audit-level=high",
    "security": "bun run audit:static && bun run audit:deps",
    "audit:release": "node scripts/static-audit.mjs --release",
    "audit:boundaries": "node scripts/dependency-boundary-audit.mjs",
    "audit:prisma": "node scripts/prisma-schema-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "prettier": "3.8.3",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "@socketsecurity/bun-security-scanner": "1.1.2"
  },
  "catalog": {
    "typescript": "5.9.2",
    "zod": "4.4.3",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/testing": "11.1.28",
    "@nestjs/websockets": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/config": "4.0.2",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.4.0",
    "prisma": "7.9.1",
    "@prisma/client": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "better-auth": "1.6.25",
    "@tanstack/react-query": "5.101.4",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "bullmq": "6.0.8",
    "@nestjs/bullmq": "11.0.4",
    "ioredis": "6.0.0",
    "rxjs": "7.8.2",
    "reflect-metadata": "0.2.2",
    "@better-auth/passkey": "1.6.25",
    "@thallesp/nestjs-better-auth": "2.7.0",
    "@socket.io/redis-adapter": "8.3.0",
    "eslint-config-next": "16.2.12"
  }
}
